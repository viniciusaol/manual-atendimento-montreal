      "parameters": {
        "jsCode": "const originalData = $('Loop Over Items').item.json;\nconst originalPhone = originalData.telefone_envio || '';\n\nfunction formatWithout55With9(phone) {\n  let clean = phone.replace(/\\D/g, '');\n  let local = clean.startsWith('55') ? clean.slice(2) : clean;\n  \n  if (local.length === 10) {\n    return local.slice(0, 2) + '9' + local.slice(2);\n  }\n  return local;\n}\n\nconst newPhone = formatWithout55With9(originalPhone);\n\nreturn [\n  {\n    json: {\n      ...originalData,\n      telefone_envio: newPhone\n    }\n  }\n];"
