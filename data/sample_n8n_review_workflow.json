    {
      "parameters": {
        "jsCode": "/* ========================================== \n   CONFIGURAÇÃO DE REVIEW E MODO TESTE \n   ========================================== */\nconst REVIEW_URL = \"https://alertas.montrealtenis.com.br/review.html\";\nconst BANNER_URL = \"https://ehhjnwosqcrfwonqhfoz.supabase.co/storage/v1/object/public/public-assets/banner_review_montreal.png\";\nconst TEST_MODE = false; // DEFINA COMO 'true' PARA TESTES SEGUROS ANTES DE DISPARAR PARA A BASE REAL\nconst TEST_PHONE = \"41988731963\";\n\n// Data de início para a Mensagem 4 (Locação Recente pós-jogo de 2h) -> Daqui a 2 semanas (06/08/2026)\nconst LOCACAO_RECENTE_START_DATE = new Date(\"2026-08-06T00:00:00-03:00\");\n\nconst pendingClients = $input.all();\nlet listToSend = [];\n\nfunction getMessageText(primeName, tipoEnvio) {\n  switch (tipoEnvio) {\n    case 'aluno':\n      return `Olá, ${primeName}! 🎾✨\\n\\nEsperamos que esteja curtindo bastante suas aulas na Montreal Tênis! 🏆\\n\\nA sua evolução e satisfação são muito importantes para nós. Poderia dedicar 1 minutinho para nos avaliar no Google? Sua opinião ajuda muito o clube e os nossos professores! 💛\\n\\n🔗 ${REVIEW_URL}\\n\\nMuito obrigado e bons treinos! 🚀`;\n    case 'mensalista':\n      return `Olá, ${primeName}! 🎾✨\\n\\nPassando para agradecer pela parceria de ter a sua reserva mensal conosco na Montreal Tênis! 🏆\\n\\nQueremos garantir que você e seu grupo tenham sempre a melhor experiência na quadra. Você poderia nos deixar uma avaliação rapidinha no Google? Conta pra gente o que está achando! 🌟\\n\\n🔗 ${REVIEW_URL}\\n\\nAgradecemos demais e excelentes jogos! 🔥`;\n    case 'locacao_passada':\n      return `Olá, ${primeName}! 🎾✨\\n\\nEsperamos que esteja bem! 🏆\\n\\nVimos que você já jogou conosco em nossas quadras na Montreal Tênis. Queremos garantir que você tenha sempre a melhor experiência!\\n\\nVocê poderia nos dedicar 1 minutinho para nos avaliar no Google? Sua opinião é fundamental para nós! 👇\\n\\n🔗 ${REVIEW_URL}\\n\\nTe esperamos em breve para o próximo jogo! 🚀`;\n    case 'locacao_recente':\n    default:\n      return `Olá, ${primeName}! 🎾✨\\n\\nEsperamos que tenha feito uma ótima partida na sua locação hoje na Montreal Tênis! 🏆\\n\\nComo foi sua experiência em nossas quadras? Sua opinião é fundamental para continuarmos melhorando. Deixe seu comentário no Google, leva menos de 1 minuto! 👇\\n\\n🔗 ${REVIEW_URL}\\n\\nTe esperamos em breve para o próximo jogo! 🚀`;\n  }\n}\n\nif (TEST_MODE) {\n  if (pendingClients.length > 0) {\n    const client = pendingClients[0].json;\n    const nomeCliente = client.customer_name || \"Jogador Teste\";\n    const primeName = (nomeCliente && nomeCliente !== 'Jogador Teste') ? nomeCliente.trim().split(' ')[0] : 'tenista';\n    const tipo = client.tipo_envio || 'locacao_recente';\n    const msgTeste = `*MODO TESTE ATIVO*\\n\\n` + getMessageText(primeName, tipo);\n    listToSend.push({\n      json: {\n        customer_code: client.customer_code,\n        name: nomeCliente,\n        categoria: client.categoria,\n        sent_count: client.sent_count || 0,\n        tipo_envio: tipo,\n        phone: TEST_PHONE,\n        telefone_envio: TEST_PHONE,\n        mensagem: msgTeste,\n        banner_url: BANNER_URL\n      }\n    });\n  }\n} else {\n  const now = new Date();\n  listToSend = pendingClients\n    .filter(item => {\n      const client = item.json;\n      // Trava para Locação Recente (Pós-Jogo 2h): só dispara a partir de 06/08/2026 (daqui 2 semanas)\n      if (client.tipo_envio === 'locacao_recente' && now < LOCACAO_RECENTE_START_DATE) {\n        return false;\n      }\n      return true;\n    })\n    .map(item => {\n      const client = item.json;\n      const nomeCliente = client.customer_name;\n      const primeName = nomeCliente ? nomeCliente.trim().split(' ')[0] : 'tenista';\n      const celular = client.mobile_normalizado;\n      const tipo = client.tipo_envio;\n      const msgReal = getMessageText(primeName, tipo);\n      \n      return {\n        json: {\n          customer_code: client.customer_code,\n          name: nomeCliente || \"Jogador\",\n          categoria: client.categoria,\n          sent_count: client.sent_count || 0,\n          tipo_envio: tipo,\n          phone: celular,\n          telefone_envio: celular,\n          mensagem: msgReal,\n          banner_url: BANNER_URL\n        }\n      };\n    });\n}\n\nreturn listToSend;"
      },
